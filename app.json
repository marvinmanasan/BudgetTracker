{
  "expo": {
    "name": "Bulsa",
    "slug": "BudgetTracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bulsa-icon.png",
    "scheme": "budgettracker",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F5EF",
        "foregroundImage": "./assets/images/bulsa-adaptive-foreground.png",
        "monochromeImage": "./assets/images/bulsa-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.marvinmanasan.bulsa",
      "versionCode": 2
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F5EF",
          "image": "./assets/images/bulsa-adaptive-foreground.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#211B18",
            "image": "./assets/images/bulsa-monochrome.png"
          }
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-sqlite",
      "expo-status-bar",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4d00fff2-ff33-486b-9467-11b63c7957fd"
      }
    }
  }
}
